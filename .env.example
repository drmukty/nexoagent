# --- Required ---
DATABASE_URL="postgresql://user:password@localhost:5432/nexoai"
# 32+ random characters:  openssl rand -base64 48
JWT_SECRET=""
# Public origin of the deployed app (used for same-origin checks on writes)
APP_ORIGIN="http://localhost:3000"

# --- Data sources (the app degrades gracefully if these are missing) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# X API v2 bearer token WITH recent-search access (paid tier). Without it /mindshare shows "Source unavailable".
X_BEARER_TOKEN=""

# --- Betting / cron ---
# Protects GET /api/cron/resolve. Send as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
# Leave unset in production (900 = 15 minutes). Lower it ONLY for local testing.
# BET_WINDOW_SECONDS=900
